    {
      "name": "Auth",
      "item": [
        {
          "name": "Sign Up",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullname\": \"Test User\",\n  \"email\": \"testuser@example.com\",\n  \"password\": \"Test1234\"\n}"
            },
            "url": { "raw": "{{base_url}}/signup", "host": ["{{base_url}}"], "path": ["signup"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has access_token', () => pm.expect(pm.response.json()).to.have.property('access_token'));",
                  "pm.environment.set('auth_token', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
